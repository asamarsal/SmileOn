# ==============================================================================
# SMILEON MOBILE APPS CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# API Mode Switcher:
# Set 'true' untuk menggunakan Mock Data (Local Storage / Offline First)
# Set 'false' untuk menggunakan Real Backend API
USE_MOCK_API=true

# Backend REST API Base URL
# Pilihan opsi:
# - Production Domain: https://api.smileon-dapps.my.id/api/v1
# - Local Wi-Fi LAN: http://192.168.1.54:8000/api/v1
# - Android Emulator: http://10.0.2.2:8000/api/v1
API_BASE_URL=https://api.smileon-dapps.my.id/api/v1

# Environment & Connection Settings
APP_ENV=development
API_CONNECT_TIMEOUT_SECONDS=15
API_RECEIVE_TIMEOUT_SECONDS=15

# Monad Testnet Settings
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
