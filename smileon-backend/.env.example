APP_NAME=SmileOn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://smileon-dapps.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smileon
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# FILESYSTEM_DISK is defined under storage section below (public)
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@smileon-dapps.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# FILESYSTEM & STORAGE CONFIGURATION
# ==============================================================================
# Pilihan FILESYSTEM_DISK: "public" (VPS), "s3" (AWS S3), "r2" (Cloudflare R2)
FILESYSTEM_DISK=public

# Pilihan target penyimpanan default: "vps", "s3", "r2", atau "google" (Drive Admin)
STORAGE_SAVE_TARGET=vps

# ------------------------------------------------------------------------------
# 1. STORAGE VPS LARAVEL (Local Web Server Storage)
# ------------------------------------------------------------------------------
VPS_STORAGE_DISK=public
VPS_STORAGE_ROOT=storage/app/public
VPS_STORAGE_URL=https://smileon-dapps.my.id/storage
VPS_STORAGE_SYMLINK_PATH=public/storage

# ------------------------------------------------------------------------------
# 2. AWS S3 / MINIO OBJECT STORAGE
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=smileon-storage
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=smileon-storage
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=https://smileon-dapps.my.id/storage
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE ADMIN (Auto Save / Export Photostrip ke Drive Admin)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ADMIN_EMAIL=admin@smileon-dapps.my.id
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=storage/app/google-service-account.json

# Monad Testnet Smart Contract
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_PAYMENT_HUB_ADDRESS=0xFAB484e78053e3FE88351A6a8A9dD545bb6a41ff
MONAD_NFT_ADDRESS=0xd685CCC9EF93b027e0D1EF05d4eDf83EC0385d48

# Firebase Cloud Messaging (FCM Push Notifications)
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_PROJECT_ID=smileon-hackathon
FCM_SERVICE_ACCOUNT_JSON=storage/app/firebase-service-account.json

# IPFS Pinata (Metadata NFT EIP-721 Monad)
PINATA_API_KEY=
PINATA_SECRET_KEY=

